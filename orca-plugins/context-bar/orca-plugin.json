{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "context-bar",
  "name": "Context Bar",
  "version": "0.2.0",
  "description": "Ce qui remplit la fenêtre de contexte de la session Claude Code suivie (workspace actif ou session choisie), par catégorie, comme /context.",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "context",
        "title": "Context Bar",
        "icon": "gauge",
        "entry": "panel/index.html"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    }
  ]
}
